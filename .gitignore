# Virtual Environments
venv/
env/
.env

# Python Cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Datasets & Large Files (GitHub has a 100MB limit)
# We ignore the heavy raw and processed datasets.
# Anyone cloning this repo can just run `python main_preprocessing.py` to regenerate them!
data/datasets/
data/processed/*.npy

# Jupyter Notebooks
.ipynb_checkpoints/

# IDE files
.vscode/
.idea/

# Frontend build output
frontend/dist/

# Runtime logs
backend/logs/*.log
data/logs/

# SQLite database instance folders (runtime-generated, machine-specific)
backend/instance/
instance/

# Accidental ghost directory (created by CWD-relative logging path bug, now fixed)
backend/backend/

# Node Modules
node_modules/

# Scratch & Temporary
scratch/

# Large Files & Data
*.pcap
*.csv
*.zip
*.rar
*.npy

# Stray SQLite Databases
*.db
